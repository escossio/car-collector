# Example configuration only. Do not put real secrets in Git.

# Runtime data directory. Production currently uses /var/lib/car-collector.
CAR_DATA_DIR=/var/lib/car-collector

# Optional API token for app.py endpoints. Leave empty only in trusted local dev.
CAR_TOKEN=change-me

# Number of NDJSON lines scanned when resolving latest telemetry in app.py.
CAR_MAX_LATEST_SCAN=5000

# PostgreSQL DSN placeholder. Replace locally with a real password outside Git.
CAR_DB_DSN=postgresql://car_user:CHANGE_ME@127.0.0.1:5432/car_collector
